# Copy this file to ".env" in the REPO ROOT. NEVER commit ".env".

# --- Local database (matches docker-compose.yml). Dev-only credentials. ---
DATABASE_URL=postgresql://glowlogic:glowlogic_dev_only@localhost:5433/glowlogic
DATABASE_SSL=false

# --- Supabase (used only for login). Get these from your Supabase project dashboard. ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key: safe to expose in a browser. The API uses it to double-check tokens.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Secret key: SERVER ONLY. Never put it in apps/web, never commit it, never share it.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# --- API ---
PORT=4000
CORS_ORIGIN=http://localhost:5173
APP_VERSION=0.1.0
